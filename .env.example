# ====================================================================
# RAG backend — copy to .env.local and fill in. NEVER commit .env.local.
# Server secrets never use the NEXT_PUBLIC_ prefix, so they never reach
# the browser. All services below have free tiers (see RAG_SETUP.md).
# ====================================================================

# --- Supabase (Postgres + pgvector) — Project Settings → API Keys -----
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (browser-safe; not used by the RAG server code).
SUPABASE_PUBLISHABLE_KEY=
# Secret key (server-only; bypasses RLS). Keep it secret.
SUPABASE_SECRET_KEY=

# --- Cloudflare Workers AI (embeddings + optional reranker) ----------
# Account ID: Cloudflare dashboard sidebar. Token: My Profile → API Tokens
# → Create Token → "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Retrieval settings ----------------------------------------------
# Rerank with @cf/baai/bge-reranker-base (extra free neurons). Default off.
RERANK_ENABLED=false
# Best chunk similarity needed to answer (else hand off). Real questions
# scored 0.52–0.73, off-topic 0.33–0.44 with bge-m3.
RAG_MIN_CONFIDENCE=0.50

# --- Phase 3 (not needed yet) -----------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Lead email notification (optional) ----------------------------------
# Every lead (RAG demo form + agent "Get your full report" form) is saved
# to Supabase. If SMTP_* and LEAD_NOTIFY_EMAIL are set, each new lead is
# also emailed. Without them the lead is still saved and a warning is
# logged. Any SMTP works, e.g. Gmail (smtp.gmail.com, 465, an app
# password), Zoho or Brevo's free SMTP. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender; defaults to "Jaseir leads <SMTP_USER>".
SMTP_FROM=
# Where lead emails go (comma-separate several addresses).
LEAD_NOTIFY_EMAIL=
# Older alternative to SMTP, used only when SMTP_* isn't set.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=

# --- Agent report gate --------------------------------------------------
# Same long random value on the dashboard AND every gated agent app
# (ai-planner, ai-content-planner, conversion-friction-analyzer,
# ai-competitor-comparison, ai-lead-qualification). The agents encrypt
# the full report with it; the dashboard decrypts it after the form is
# submitted. Generate one with: openssl rand -base64 32
# Without it, full reports reach the browser and are only blurred.
REPORT_UNLOCK_SECRET=

# --- Leads admin (/leads-admin/) -----------------------------------------
# At least 16 characters. Unset = the admin page and GET API are off.
LEADS_ADMIN_KEY=
